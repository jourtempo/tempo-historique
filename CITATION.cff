cff-version: 1.2.0
message: "If you use this dataset, please cite it as below and credit the source: Couleurs Tempo : RTE, via Jour Tempo."
type: dataset
title: "Tempo day colours since 2014-2015 (daily dataset)"
doi: 10.5281/zenodo.23422802
abstract: >-
  Daily colour (blue, white or red) of the French Tempo electricity tariff since 1 September 2014,
  one line per day with date, colour and season, as published by RTE (API Tempo Like Supply Contract,
  data.rte-france.com) and compiled by Jour Tempo. The live file is updated every day at
  https://jourtempo.fr/api/v1/tempo-historique.csv
authors:
  - name: "Jour Tempo"
    email: contact@jourtempo.fr
    website: "https://jourtempo.fr"
version: "2026-10-16"
date-released: "2026-10-16"
license: etalab-2.0
url: "https://jourtempo.fr/api/"
repository-code: "https://github.com/jourtempo/tempo-historique"
keywords:
  - Tempo
  - EDF
  - RTE
  - electricity
  - tariff
  - France
  - open data
  - time series
references:
  - type: data
    title: "Tempo Like Supply Contract"
    authors:
      - name: "RTE (Réseau de Transport d'Électricité)"
    url: "https://data.rte-france.com/catalog/-/api/consumption/Tempo-Like-Supply-Contract/v1.1"
